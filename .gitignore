# This repository is only the MV workbench package. Project docs, local data,
# generated media, credentials, and scratch scripts are deliberately excluded.
# The public acknowledgements are the sole documentation exception.
/*
!/.gitignore
!/ACKNOWLEDGEMENTS.md
!/README.md
!/README_EN.md
!/CHANGELOG.md
!/*.py
!/requirements.txt
!/web/
!/skills/
!/tests/
!/workflows/

/web/*
!/web/mv_planner.js
!/web/mv_planner.css
!/web/mv_preview.js
!/web/mv_preview.css

/skills/*
!/skills/xiaoyue-h3-mv-prompt/
!/skills/xiaoyue-mv-visual-outline/

/tests/*
!/tests/test_*.py

/workflows/*
!/workflows/MiniMaxH3_MV_Planner_xiaoyue_MV工作台v1.0.json

__pycache__/
*.py[cod]
.pytest_cache/
.coverage
.env
.env.*
local_config.json
*.pem
*.key
*.p12
*.pfx
*.token
*.log
*.tmp
*.bak
*.zip
*.mp4
*.mov
*.wav
*.mp3
*.png
*.jpg
*.jpeg
*.webp
**/tmp*/
**/temp*/
**/scratch*/
**/debug*/

# Three user-approved, illustrative screenshots for the GitHub README.
!/assets/
!/assets/screenshots/
!/assets/screenshots/01-project-setup.png
!/assets/screenshots/02-mv-workbench.png
!/assets/screenshots/03-preview-desk.png
